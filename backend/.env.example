# Copy this file to .env and fill in real values. .env is in .gitignore,
# so real secrets never reach GitHub. In production these are set in the
# Render dashboard instead.

NODE_ENV=development
PORT=4000

# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Long random string used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Optional settings (defaults shown)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_DAYS=7
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://gram-shiksha-mu.vercel.app
# TRUST_PROXY=1
# DB_POOL_MAX=10
# LOG_SQL=true

# AI lesson generation (one of these; without both, a demo lesson is returned)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Password for the demo accounts created by `npm run seed` (local use only)
SEED_PASSWORD=
