{
  "lessons": [
    {
      "id": 1,
      "title": "The Water Cycle",
      "summary": "Water evaporates from rivers and oceans, forms clouds, and returns as rain. This cycle keeps our wells and fields supplied.",
      "summary_hi": "नदियों और समुद्र का पानी भाप बनकर बादल बनाता है और फिर बारिश के रूप में लौटता है। इसी चक्र से हमारे कुएँ और खेत भरते हैं।",
      "quiz": [
        {
          "q": "What turns water into vapour?",
          "options": [
            "Sun's heat",
            "Moon",
            "Soil"
          ],
          "answer": 0
        },
        {
          "q": "What is water falling from clouds called?",
          "options": [
            "Evaporation",
            "Precipitation",
            "Condensation"
          ],
          "answer": 1
        }
      ]
    },
    {
      "id": 2,
      "title": "Photosynthesis",
      "summary": "Plants use sunlight, water and carbon dioxide to make their own food, and they release oxygen.",
      "summary_hi": "पौधे सूरज की रोशनी, पानी और कार्बन डाइऑक्साइड से अपना भोजन बनाते हैं और ऑक्सीजन छोड़ते हैं।",
      "quiz": [
        {
          "q": "Which gas do plants release?",
          "options": [
            "Oxygen",
            "Nitrogen",
            "Smoke"
          ],
          "answer": 0
        },
        {
          "q": "What gives leaves their green colour?",
          "options": [
            "Chlorophyll",
            "Soil",
            "Water"
          ],
          "answer": 0
        }
      ]
    },
    {
      "id": 3,
      "title": "Fractions",
      "summary": "A fraction shows part of a whole. In 3/4, 3 is the numerator and 4 is the denominator.",
      "summary_hi": "भिन्न किसी पूरे का एक हिस्सा दिखाती है। 3/4 में 3 अंश है और 4 हर है।",
      "quiz": [
        {
          "q": "In 1/2, which number is the denominator?",
          "options": [
            "1",
            "2",
            "3"
          ],
          "answer": 1
        },
        {
          "q": "Which fraction is the biggest?",
          "options": [
            "1/4",
            "1/2",
            "1/8"
          ],
          "answer": 1
        }
      ]
    },
    {
      "id": 1794606187974,
      "title": "Force and Motion",
      "summary": "A force is a push or a pull that can change the motion or shape of an object. Friction is a resistive force that opposes motion between surfaces sliding against each other. Gravity pulls objects toward the center of the Earth and gives them weight. Balanced forces keep an object at rest or moving at a constant speed.",
      "summary_hi": "बल एक धक्का या खिंचाव है जो किसी वस्तु की गति या आकार को बदल सकता है। घर्षण एक विरोधी बल है जो एक दूसरे के संपर्क में आने वाली सतहों की गति को रोकता है। गुरुत्वाकर्षण वस्तुओं को पृथ्वी के केंद्र की ओर खींचता है और उन्हें भार देता है। संतुलित बल किसी वस्तु को स्थिर या एक समान गति में रखते हैं।",
      "quiz": [
        {
          "q": "What is a force?",
          "options": [
            "A push or a pull",
            "Only heat",
            "Sound energy"
          ],
          "answer": 0
        },
        {
          "q": "Which force slows down a moving bicycle when you stop pedaling?",
          "options": [
            "Magnetic force",
            "Friction",
            "Electric force"
          ],
          "answer": 1
        },
        {
          "q": "What force pulls dropped objects toward the ground?",
          "options": [
            "Friction",
            "Tension",
            "Gravity"
          ],
          "answer": 2
        },
        {
          "q": "What happens when balanced forces act on a stationary rock?",
          "options": [
            "It remains at rest",
            "It flies upward",
            "It explodes"
          ],
          "answer": 0
        },
        {
          "q": "Why do rough surfaces produce more friction than smooth surfaces?",
          "options": [
            "They are colder",
            "Microscopic bumps interlock more",
            "They have less mass"
          ],
          "answer": 1
        }
      ]
    }
  ],
